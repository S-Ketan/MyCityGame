@startuml
title My City Game Flow

|System|
start
:Spiel wird initialisiert;
note right: FirstScreen

|Spieler 1|
:Gibt Namen ein;

|Spieler 2|
:Gibt Namen ein;

|System|
:Spiel starten;
note right: `GameScreen` wird geladen

partition "Kapitel-Schleife" {
  while (Aktuelles Kapitel <= 24) is (ja)
    |System|
    :Neues Kapitel laden;
    note right
        - `spiel.kapitelLaden()`
        - Ggf. Sticker-Platzierung (z.B. Brunnen)
    end note

    partition "Runden-Schleife (Spieler 1)" {
        |System|
        :Spieler 1 ist an der Reihe;

        while (Plättchen im Deck) is (ja)
            :Nächstes Plättchen ziehen;
            |Spieler 1|
            fork
                :Platziert Plättchen (Drag & Drop);
                |System|
                if (Platzierung gültig?) then (ja)
                    :Plättchen wird auf Stadtplan gelegt;
                    :Punktestand aktualisieren;
                else (nein)
                    :Aktion ablehnen;
                    |Spieler 1|
                    :Plättchen zurücksetzen;
                endif
            fork again
                |Spieler 1|
                :Überspringt Plättchen;
                |System|
                :Minuspunkt vergeben;
            fork again
                |Spieler 1|
                :Dreht Plättchen;
            end fork
        endwhile (nein)
    }

    partition "Runden-Schleife (Spieler 2)" {
        |System|
        :Spieler 2 ist an der Reihe;
        note right: Gleicher Plättchenstapel wird erneut durchlaufen

        while (Plättchen im Deck) is (ja)
            :Nächstes Plättchen ziehen;
            |Spieler 2|
            fork
                :Platziert Plättchen (Drag & Drop);
                |System|
                if (Platzierung gültig?) then (ja)
                    :Plättchen wird auf Stadtplan gelegt;
                    :Punktestand aktualisieren;
                else (nein)
                    :Aktion ablehnen;
                    |Spieler 2|
                    :Plättchen zurücksetzen;
                endif
            fork again
                |Spieler 2|
                :Überspringt Plättchen;
                |System|
                :Minuspunkt vergeben;
            fork again
                |Spieler 2|
                :Dreht Plättchen;
            end fork
        endwhile (nein)
    }

    |System|
    :Kapitelende anzeigen;
    note right
      `GameScreen` -> `ChapterEndScreen`
      - Punkte-Aufschlüsselung
      - Fortschrittspunkte
    end note

    if (Kapitel 1-3?) then (ja)
      |System|
      :Sticker-Platzierung vorbereiten;
      note right
        `ChapterEndScreen` -> `StickerPlacementScreen`
        - Gewinner: Fels-Sticker
        - Verlierer: Baum/Brunnen-Sticker
      end note
      
      if (Spieler 1 ist Gewinner) then (ja)
        |Spieler 1|
        :Platziert Fels-Sticker;
        |Spieler 2|
        :Platziert Baum/Brunnen-Sticker;
      else (nein)
        |Spieler 2|
        :Platziert Fels-Sticker;
        |Spieler 1|
        :Platziert Baum/Brunnen-Sticker;
      endif
    endif

    |System|
    if (Spiel gewonnen?) then (ja)
      :Endstand anzeigen;
      stop
    endif
  endwhile (nein)
}

|System|
:Endstand anzeigen;
stop

@enduml
